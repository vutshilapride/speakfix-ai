// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_DATABASE_URL")
}

model User {
  id                String    @id @default(cuid())
  name              String
  email             String    @unique
  passwordHash      String
  preferredLanguage String    @default("English")
  // USER | TECHNICIAN | ADMIN
  role              String    @default("USER")
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  tickets           Ticket[]            @relation("Reporter") // tickets reported by this user
  assignedTickets   Ticket[]            @relation("AssignedTechnician") // tickets this user is assigned to as technician
  sessions          Session[]
  resetTokens       PasswordResetToken[]
  taughtPhrases     LearnedPhrase[]     @relation("Teacher") // phrases this user taught Iris
  evidenceUploads   EvidenceFile[]      @relation("EvidenceUploader") // evidence files this user uploaded
}

model Session {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime @default(now())
}

model Ticket {
  id            String    @id @default(cuid())
  ticketNumber  String    @unique
  title         String
  description   String
  category      String
  priority      String
  // OPEN | IN_PROGRESS | AWAITING_VERIFICATION | RESOLVED | REOPENED
  status        String    @default("OPEN")
  location      String
  requesterName String    @default("Anonymous")
  contactInfo   String?
  urgencyReason String?
  source        String    @default("voice")
  transcript    String    @default("")
  userId        String?
  user          User?     @relation("Reporter", fields: [userId], references: [id], onDelete: SetNull)

  // ---- Verified resolution workflow ----
  // Technician who is assigned to this ticket
  assignedTechnicianId String?
  assignedTechnician   User?   @relation("AssignedTechnician", fields: [assignedTechnicianId], references: [id], onDelete: SetNull)
  // What the technician actually fixed (structured, from voice or typed)
  technicianAction     String?
  // Resolution notes submitted by the technician
  resolutionNotes      String?
  // Test / result recorded to support the fix
  testResult           String?
  // JSON array of evidence entries: [{ "type": "photo|checklist|part|note|voice", "label": "...", "note": "..." }]
  evidence             String?
  resolutionSubmittedAt DateTime?
  // Cautious AI note comparing complaint vs resolution (never accusatory)
  resolutionCheckNote  String?
  // When the reporter confirmed the problem is actually fixed
  reporterConfirmedAt  DateTime?
  // Last thing the reporter said when confirming / reopening
  reporterResponse     String?
  // How many times the reporter reopened this ticket
  reopenCount          Int     @default(0)
  // Similar past incidents found when the ticket was created (real data only)
  similarIncidentCount Int?
  similarIncidentNote  String?

  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  audit         AuditEntry[]
  evidenceFiles EvidenceFile[]
}

/// A real file attached as evidence to a ticket (photo of the fix, part
/// invoice, voice note…). Bytes live in Postgres so evidence survives on any
/// host without an external bucket. ticketId is null while the file is a
/// draft (uploaded but not yet submitted with the ticket).
model EvidenceFile {
  id         String   @id @default(cuid())
  ticketId   String?
  ticket     Ticket?  @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  fileName   String
  mimeType   String
  size       Int
  data       Bytes
  uploadedBy String?
  uploader   User?    @relation("EvidenceUploader", fields: [uploadedBy], references: [id], onDelete: SetNull)
  createdAt  DateTime @default(now())

  @@index([ticketId])
}

/// Immutable record of every important action on a ticket.
model AuditEntry {
  id        String   @id @default(cuid())
  ticketId  String
  ticket    Ticket   @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  // null = SpeakFix system action
  actorId   String?
  actorName String
  // REPORTER | TECHNICIAN | ADMIN | SYSTEM
  actorRole String
  // TICKET_CREATED | ASSIGNED | WORK_STARTED | RESOLUTION_SUBMITTED | EVIDENCE_SUBMITTED |
  // VERIFICATION_REQUESTED | REPORTER_CONFIRMED | TICKET_REOPENED | TICKET_DELETED | DETAILS_UPDATED
  action    String
  // Human-readable sentence shown in the timeline
  detail    String?
  createdAt DateTime @default(now())

  @@index([ticketId, createdAt])
}

/// A phrase Iris learned from a user during free-talk conversations.
/// Iris is learning languages she doesn't yet speak well (isiZulu, isiXhosa,
/// Xitsonga, …) directly from the people who use SpeakFix — one phrase at a
/// time. Learned phrases are injected into her prompts so she can use them.
model LearnedPhrase {
  id        String   @id @default(cuid())
  // Free-form language name as the user says it, e.g. "isiXhosa", "Xitsonga"
  language  String
  // The phrase in the language being learned, e.g. "the tap is leaking"
  phrase    String
  // English meaning of the phrase, e.g. "the tap is leaking"
  meaning   String
  // Optional usage note from the conversation (register, dialect, politeness…)
  note      String?
  // Account of the user who taught it (for attribution + quality review)
  userId    String?
  user      User?    @relation("Teacher", fields: [userId], references: [id], onDelete: SetNull)
  createdAt DateTime @default(now())

  @@index([language, createdAt])
}
